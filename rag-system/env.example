# ============================================
# Supabase Configuration
# ============================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# ============================================
# OpenAI Configuration (для embeddings)
# ============================================
OPENAI_API_KEY=your-openai-api-key
EMBEDDING_MODEL=text-embedding-ada-002
EMBEDDING_DIMENSION=1536

# ============================================
# RAG Configuration
# ============================================
# Минимальный порог схожести (0.0 - 1.0)
SIMILARITY_THRESHOLD=0.7

# Максимальное количество похожих работ для контекста
MAX_SIMILAR_SUBMISSIONS=5

# Максимальное количество связанных концепций
MAX_RELATED_CONCEPTS=10

# ============================================
# Cache Configuration
# ============================================
# Включить кэширование уроков
ENABLE_CACHE=true

# Время жизни кэша в секундах (86400 = 24 часа)
CACHE_EXPIRATION=86400

# Автоматически обновлять устаревший кэш
AUTO_REFRESH_CACHE=true

# ============================================
# GraphRAG Configuration (опционально)
# ============================================
# Включить граф знаний
ENABLE_GRAPH=false

# Провайдер графа: 'neo4j' или 'memory'
GRAPH_PROVIDER=memory

# Neo4j (если используется)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# ============================================
# Knowledge Builder Configuration
# ============================================
# Минимальное количество принятых работ для создания базы знаний
MIN_ACCEPTED_SUBMISSIONS=3

# Включить автоматическое извлечение концепций
AUTO_EXTRACT_CONCEPTS=true

# Модель для извлечения концепций
CONCEPT_EXTRACTION_MODEL=llama-3.3-70b-versatile

# ============================================
# Performance Configuration
# ============================================
# Размер батча для векторизации
BATCH_SIZE=10

# Таймаут для запросов к Supabase (мс)
SUPABASE_TIMEOUT=30000

# Максимальное количество параллельных запросов
MAX_CONCURRENT_REQUESTS=5

# ============================================
# Logging Configuration
# ============================================
# Уровень логирования: 'debug', 'info', 'warn', 'error'
LOG_LEVEL=info

# Логировать статистику использования кэша
LOG_CACHE_STATS=true

# Логировать время выполнения запросов
LOG_QUERY_TIME=true

# ============================================
# Feature Flags
# ============================================
# Использовать RAG при проверке работ
USE_RAG_FOR_CHECKING=true

# Сохранять все проверенные работы в БД
SAVE_ALL_SUBMISSIONS=true

# Обновлять граф при каждой проверке
UPDATE_GRAPH_ON_CHECK=false





